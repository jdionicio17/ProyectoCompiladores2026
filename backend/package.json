{
  "name": "compilador-sql-backend",
  "version": "1.0.0",
  "description": "Backend del compilador SQL web para el curso de Compiladores.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "test": "vitest run tests/lexer.test.ts",
  "test:all": "vitest run",
  "test:watch": "vitest"
},
  "keywords": [
    "compiler",
    "sql",
    "lexer",
    "parser",
    "semantic-analyzer",
    "typescript",
    "express"
  ],
  "author": "Grupo Alianza Laboral",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}